          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/FeedbackQuestion"
