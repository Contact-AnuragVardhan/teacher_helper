{
  "$defs": {
    "FeedbackChoiceOption": {
      "properties": {
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "FeedbackChoiceOption",
      "type": "object"
    },
    "FeedbackPart": {
